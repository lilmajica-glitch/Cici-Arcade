{
  "name": "ciciarcade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm --prefix neon-word-runner run typecheck",
    "postinstall": "npm --prefix neon-word-runner ci",
    "intro:preview": "remotion studio src/intro/index.tsx",
    "intro:render": "remotion render src/intro/index.tsx NeonRunnerIntro public/intro.mp4"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.532",
    "gsap": "^3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.532",
    "three": "^0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
